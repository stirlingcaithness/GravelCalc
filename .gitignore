# ---------------------------------------------
# .gitignore for GravelCalc (Electron + electron-builder)
# ---------------------------------------------

# Node dependencies (this is what was causing your push to fail)
node_modules/

# Electron-builder build output
dist/
release/
out/
build/

# Packaged app artifacts
*.exe
*.msi
*.dmg
*.AppImage
*.deb
*.rpm
*.blockmap

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment / secrets
.env
.env.local
.env.*.local

# Editor / IDE
.vscode/
.idea/
*.swp

# OS-generated files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Optional cache folders
.npm/
.cache/

# Generated Excel test output (uncomment if your app writes these locally)
# *.xlsx
